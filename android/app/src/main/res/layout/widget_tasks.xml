<?xml version="1.0" encoding="utf-8"?>
<!-- Oldest tasks: the glass with its header, and up to three task rows laid
     over it, each its own picture so a task finished here disappears at
     once. The weights match TaskRows in home_widget_views.dart (40 header,
     36 per row, 12 below, of 160). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Both glass variants are set; the system theme picks which shows
         (values/ and values-night/widget_theme.xml), so the launcher swaps
         them on a light/dark switch without asking the app. -->
    <ImageView
        android:id="@+id/widget_image_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_image_description"
        android:scaleType="fitCenter"
        android:visibility="@integer/widget_dark_visibility" />

    <ImageView
        android:id="@+id/widget_image_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_image_description"
        android:scaleType="fitCenter"
        android:visibility="@integer/widget_light_visibility" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The header: tap to add a task. -->
        <FrameLayout
            android:id="@+id/tap_add"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="40" />

        <!-- Row 0: its own picture; the check finishes the task, the rest
             opens the small task card. -->
        <FrameLayout
            android:id="@+id/row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/row_0_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_image_description"
                android:scaleType="fitCenter"
                android:visibility="@integer/widget_dark_visibility" />

            <ImageView
                android:id="@+id/row_0_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_image_description"
                android:scaleType="fitCenter"
                android:visibility="@integer/widget_light_visibility" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tap_check_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/tap_task_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4" />
            </LinearLayout>
        </FrameLayout>

        <!-- Row 1: its own picture; the check finishes the task, the rest
             opens the small task card. -->
        <FrameLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/row_1_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_image_description"
                android:scaleType="fitCenter"
                android:visibility="@integer/widget_dark_visibility" />

            <ImageView
                android:id="@+id/row_1_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_image_description"
                android:scaleType="fitCenter"
                android:visibility="@integer/widget_light_visibility" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tap_check_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/tap_task_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4" />
            </LinearLayout>
        </FrameLayout>

        <!-- Row 2: its own picture; the check finishes the task, the rest
             opens the small task card. -->
        <FrameLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="36"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/row_2_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_image_description"
                android:scaleType="fitCenter"
                android:visibility="@integer/widget_dark_visibility" />

            <ImageView
                android:id="@+id/row_2_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_image_description"
                android:scaleType="fitCenter"
                android:visibility="@integer/widget_light_visibility" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tap_check_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/tap_task_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4" />
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12" />
    </LinearLayout>
</FrameLayout>
