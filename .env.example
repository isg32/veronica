# Copy to .env and fill in. .env is gitignored: never commit real values.
#
# VERONICA_KEYSTORE_BASE64: base64 -w0 path/to/release-key.jks
VERONICA_KEYSTORE_BASE64=
VERONICA_KEYSTORE_PASSWORD=
# Optional: defaults to VERONICA_KEYSTORE_PASSWORD.
VERONICA_KEY_PASSWORD=
# Optional: defaults to "upload".
VERONICA_KEY_ALIAS=upload
